# Environment variables for local development

# Database
DATABASE_URL="postgresql://labuser:labpassword@localhost:5432/lab_management"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# API
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR="./uploads"

# Redis (for future use)
REDIS_URL="redis://localhost:6379"

# Docker Compose
# In containers, the backend uses postgres and redis service names automatically.
# NEXT_PUBLIC_API_URL must remain reachable from the browser.
